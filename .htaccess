# Formation CFPC · Formatome
Options -Indexes
DirectoryIndex index.html

<IfModule mod_mime.c>
AddType image/webp .webp
AddType font/ttf .ttf
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule "(^|/)\.git(?:/|$)" - [F,L,NC]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://cfpc.formatome.fr%{REQUEST_URI} [R=301,L,NE]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Robots-Tag "noindex, nofollow, noarchive"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'self'"
</IfModule>
